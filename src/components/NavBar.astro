---
// Global masthead bar: four top-level sections. No JS needed for navigation.
// This bar is expected to grow (login, collaboration) when the platform
// opens — add top-level items sparingly.
import Glyph from './Glyph.astro';
import Wordmark from './Wordmark.astro';

const links = [
  { label: 'Essays', href: '/essays' },
  { label: 'Manifesto', href: '/manifesto' },
  { label: 'About', href: '/about' },
  { label: 'Openness', href: '/openness' },
];

// strip build.format 'file' extensions and trailing slashes before matching
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
// Essays is a section (any essay page lights it); the rest match exactly.
// Home "/" is deliberately not represented in the nav.
const isActive = (href: string) =>
  href === '/essays' ? path.startsWith('/essays') : path === href;
---

<header class="masthead">
  <div class="bar">
    <a href="/" class="lockup" aria-label="The Reducing Valve — home">
      <Glyph width={40} stroke={4} />
      <Wordmark />
    </a>
    <nav aria-label="Sections">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['top-link', { active: isActive(l.href) }]}
          aria-current={path === l.href ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--rv-rule);
    background: var(--rv-navy);
    position: relative;
    z-index: 10;
  }
  .bar {
    max-width: var(--rv-frame, 1200px);
    margin: 0 auto;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    flex-wrap: wrap;
  }
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .lockup:hover {
    opacity: 0.85;
  }
  nav {
    display: flex;
    gap: 26px;
    align-items: center;
    flex-wrap: wrap;
  }
  .top-link {
    font-family: var(--rv-font-sans);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rv-text-dim);
    padding-bottom: 6px;
    border-bottom: 2px solid transparent;
  }
  .top-link:hover {
    color: var(--rv-text-strong);
  }
  .top-link.active {
    color: var(--rv-text-strong);
    border-bottom-color: var(--rv-amber);
  }

  /* narrow screens: tighten so four links wrap without overflow */
  @media (max-width: 560px) {
    .bar {
      padding: 14px 16px;
      gap: 12px 18px;
    }
    nav {
      gap: 12px 18px;
    }
  }
</style>
